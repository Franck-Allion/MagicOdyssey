[gd_scene load_steps=2 format=3]

[ext_resource type="Theme" path="res://resources/themes/fantasy_theme.tres" id="1"]

[node name="ThemeShowcase" type="PanelContainer"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1")
theme_type_variation = &"CanvasPanel"

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 64
theme_override_constants/margin_right = 64
theme_override_constants/margin_top = 40
theme_override_constants/margin_bottom = 40

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2

[node name="Eyebrow" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_type_variation = &"SecondaryText"
text = "MAGICODYSSEY  /  THE ART OF BATTLE"

[node name="Title" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_type_variation = &"ScreenTitle"
text = "MagicOdyssey"

[node name="Subtitle" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_type_variation = &"SecondaryText"
text = "A foundation of iron, parchment and quiet gold."

[node name="Panel" type="PanelContainer" parent="Margin/Content"]
layout_mode = 2

[node name="Samples" type="VBoxContainer" parent="Margin/Content/Panel"]
layout_mode = 2

[node name="Heading" type="Label" parent="Margin/Content/Panel/Samples"]
layout_mode = 2
theme_type_variation = &"SectionHeading"
text = "01  /  The war table"

[node name="FixtureNote" type="Label" parent="Margin/Content/Panel/Samples"]
layout_mode = 2
theme_type_variation = &"SecondaryText"
text = "Presentation fixtures only - no combat state or actions."

[node name="Actions" type="HBoxContainer" parent="Margin/Content/Panel/Samples"]
layout_mode = 2

[node name="Primary" type="Button" parent="Margin/Content/Panel/Samples/Actions"]
layout_mode = 2
custom_minimum_size = Vector2(240, 64)
text = "Primary action"
tooltip_text = "Presentation sample. Tab to inspect keyboard focus."

[node name="Secondary" type="Button" parent="Margin/Content/Panel/Samples/Actions"]
layout_mode = 2
custom_minimum_size = Vector2(240, 64)
theme_type_variation = &"SecondaryButton"
text = "Secondary action"
tooltip_text = "Presentation sample. Tab to inspect keyboard focus."

[node name="Disabled" type="Button" parent="Margin/Content/Panel/Samples/Actions"]
layout_mode = 2
custom_minimum_size = Vector2(240, 64)
disabled = true
text = "Unavailable"
tooltip_text = "Presentation sample. Tab to inspect keyboard focus."

[node name="Statistics" type="Label" parent="Margin/Content/Panel/Samples"]
layout_mode = 2
theme_type_variation = &"TacticalNumber"
text = "ATK  4     /     HP  7     /     Armor  2     /     Shield  3"

[node name="Camps" type="HBoxContainer" parent="Margin/Content/Panel/Samples"]
layout_mode = 2

[node name="Player" type="Label" parent="Margin/Content/Panel/Samples/Camps"]
layout_mode = 2
theme_type_variation = &"PlayerLabel"
text = "[P] PLAYER"

[node name="Opponent" type="Label" parent="Margin/Content/Panel/Samples/Camps"]
layout_mode = 2
theme_type_variation = &"OpponentLabel"
text = "[O] OPPONENT"

[node name="Neutral" type="Label" parent="Margin/Content/Panel/Samples/Camps"]
layout_mode = 2
theme_type_variation = &"NeutralLabel"
text = "[-] INACTIVE"

[node name="States" type="HBoxContainer" parent="Margin/Content/Panel/Samples"]
layout_mode = 2

[node name="Selected" type="Label" parent="Margin/Content/Panel/Samples/States"]
layout_mode = 2
theme_type_variation = &"SelectedLabel"
text = "[+] SELECTED"

[node name="Valid" type="Label" parent="Margin/Content/Panel/Samples/States"]
layout_mode = 2
theme_type_variation = &"ValidLabel"
text = "[OK] VALID"

[node name="Invalid" type="Label" parent="Margin/Content/Panel/Samples/States"]
layout_mode = 2
theme_type_variation = &"InvalidLabel"
text = "[X] INVALID"

[node name="RarityHeading" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_type_variation = &"SectionHeading"
text = "02  /  Rarity signatures"

[node name="Rarities" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2

[node name="Common" type="Label" parent="Margin/Content/Rarities"]
layout_mode = 2
theme_type_variation = &"CommonLabel"
text = "[===] COMMON"

[node name="Uncommon" type="Label" parent="Margin/Content/Rarities"]
layout_mode = 2
theme_type_variation = &"UncommonLabel"
text = "[===] UNCOMMON"

[node name="Rare" type="Label" parent="Margin/Content/Rarities"]
layout_mode = 2
theme_type_variation = &"RareLabel"
text = "[===] RARE"

[node name="Epic" type="Label" parent="Margin/Content/Rarities"]
layout_mode = 2
theme_type_variation = &"EpicLabel"
text = "[===] EPIC"

[node name="Legendary" type="Label" parent="Margin/Content/Rarities"]
layout_mode = 2
theme_type_variation = &"LegendaryLabel"
text = "[===] LEGENDARY"

[node name="Tooltip" type="PanelContainer" parent="Margin/Content"]
layout_mode = 2
theme_type_variation = &"TooltipPanel"

[node name="TooltipSample" type="Label" parent="Margin/Content/Tooltip"]
layout_mode = 2
theme_type_variation = &"TooltipText"
text = "SHIELD  /  Sample reserve: 3. This text demonstrates tooltip readability."

[node name="Footer" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_type_variation = &"SecondaryText"
text = "DESIGN STUDY  /  P004                 Hover buttons / Tab for focus / Static values"


